<service>
  <id>PoyiWatchMcp</id>
  <name>Poyi Watch MCP</name>
  <description>Independent MCP server for WatchIntervals.</description>
  <executable>powershell.exe</executable>
  <arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "%BASE%\service\run-service.ps1"</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <env name="WATCH_MCP_DATA_DIR" value="%WATCH_MCP_DATA_DIR%" />
  <env name="PYTHONUTF8" value="1" />
  <env name="PYTHONUNBUFFERED" value="1" />
  <env name="PYTHONNOUSERSITE" value="1" />
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <stoptimeout>20sec</stoptimeout>
  <onfailure action="restart" delay="5 sec" />
  <onfailure action="restart" delay="15 sec" />
  <onfailure action="restart" delay="60 sec" />
  <resetfailure>1 hour</resetfailure>
  <logpath>%WATCH_MCP_DATA_DIR%\service-logs\mcp</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
